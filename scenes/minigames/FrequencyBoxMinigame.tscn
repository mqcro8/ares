[sub_resource type="Shader" id="Shader_crt"]
code = "shader_type canvas_item;\n\nuniform vec4 tint : source_color = vec4(0.02, 0.08, 0.04, 1.0);\nuniform float scanline_count : hint_range(10.0, 400.0) = 120.0;\nuniform float scanline_strength : hint_range(0.0, 1.0) = 0.5;\nuniform float flicker_strength : hint_range(0.0, 0.5) = 0.06;\nuniform float band_strength : hint_range(0.0, 1.0) = 0.22;\nuniform float noise_strength : hint_range(0.0, 0.5) = 0.06;\nuniform float vignette_strength : hint_range(0.0, 1.0) = 0.8;\n\nfloat hash(vec2 p) {\n\treturn fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat d = distance(uv, vec2(0.5));\n\tif (d > 0.5) {\n\t\tdiscard;\n\t}\n\n\tfloat edge = smoothstep(0.5, 0.45, d);\n\tfloat scan = 0.5 + 0.5 * sin(uv.y * scanline_count * 6.2831853 + TIME * 2.0);\n\tfloat band = smoothstep(0.10, 0.0, abs(uv.y - fract(TIME * 0.15)));\n\tfloat flick = 1.0 - flicker_strength * (0.5 + 0.5 * sin(TIME * 47.0));\n\tfloat noise = hash(floor(uv * vec2(96.0, 96.0)) + floor(TIME * 12.0));\n\n\tfloat a = scanline_strength * (1.0 - scan) * 0.55;\n\ta += band * band_strength;\n\ta += noise * noise_strength;\n\ta += smoothstep(0.28, 0.5, d) * vignette_strength * 0.5;\n\ta *= edge * flick;\n\n\tvec3 col = tint.rgb * (0.55 + 0.75 * scan);\n\tcol += vec3(0.05, 0.25, 0.10) * band;\n\tCOLOR = vec4(col, clamp(a, 0.0, 0.85));\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = SubResource("Shader_crt")

[sub_resource type="Shader" id="Shader_knob"]
code = "shader_type canvas_item;\n\nuniform vec4 base_color : source_color = vec4(0.165, 0.173, 0.18, 1.0);\nuniform vec4 rim_color : source_color = vec4(0.62, 0.64, 0.67, 1.0);\nuniform vec4 dark_color : source_color = vec4(0.06, 0.065, 0.07, 1.0);\n\nvoid fragment() {\n\tvec2 p = UV * 2.0 - 1.0;\n\tfloat r = length(p);\n\tif (r > 1.0) {\n\t\tdiscard;\n\t}\n\n\tfloat shade = smoothstep(1.0, 0.0, r);\n\tvec3 col = mix(dark_color.rgb, base_color.rgb, 0.45 + 0.55 * shade);\n\n\tfloat bevel = smoothstep(0.72, 0.98, r) * smoothstep(1.0, 0.94, r);\n\tcol = mix(col, rim_color.rgb * 0.55, bevel);\n\n\tfloat hi = smoothstep(0.55, 0.0, length(p - vec2(-0.32, -0.38)));\n\tcol += hi * 0.10;\n\n\tfloat ang = atan(p.y, p.x);\n\tfloat notch = step(0.90, cos(ang * 18.0)) * smoothstep(0.78, 0.92, r);\n\tcol = mix(col, rim_color.rgb, notch * 0.35);\n\n\tCOLOR = vec4(col, 1.0);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_knob"]
shader = SubResource("Shader_knob")

